/* ============================================================
   TEMA DARK PREMIUM & OLED - ESTILO FOOTBALL CLUB MANAGEMENT
   ============================================================ */

:root {
  --bg-main: #090a0f;           /* Preto azulado profundo */
  --bg-card: #12141d;           /* Cartão metálico escuro */
  --bg-card-hover: #1a1d2b;
  --bg-input: #181b26;
  --border-color: #232738;
  
  --text-primary: #ffffff;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  
  --accent-blue: #3b82f6;
  --accent-gold: #eab308;
  --accent-green: #22c55e;
  --red: #ef4444;
}

* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

body {
  margin: 0;
  padding: 0;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", sans-serif;
  background-color: var(--bg-main) !important;
  color: var(--text-primary) !important;
}

/* ---------- TELA INICIAL (HERO) ---------- */
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at center, #1e2338 0%, var(--bg-main) 100%);
  padding: 20px;
  text-align: center;
}

.brand {
  font-size: 42px;
  font-weight: 900;
  letter-spacing: -1px;
  margin: 0;
}
.brand span { color: var(--accent-blue); }
.tag { color: var(--text-secondary); margin-bottom: 24px; }

.newgame-box {
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-width: 320px;
  margin: 0 auto;
}

/* ---------- ESTRUTURA DO JOGO ---------- */
.app {
  display: block;
  min-height: 100vh;
  padding-bottom: 80px;
}

.topbar {
  background: rgba(18, 20, 29, 0.9);
  backdrop-filter: blur(15px);
  border-bottom: 1px solid var(--border-color);
  padding: 12px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 50;
}

.mini { font-weight: 900; font-size: 18px; }
.mini span { color: var(--accent-blue); }

.topbar-money {
  background: var(--bg-input);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 6px 12px;
  font-weight: 800;
  color: var(--accent-gold);
}

.desktop-nav {
  display: flex;
  gap: 6px;
  background: var(--bg-card);
  padding: 8px 20px;
  border-bottom: 1px solid var(--border-color);
  overflow-x: auto;
}

.desktop-nav button {
  background: transparent;
  color: var(--text-secondary);
  border: none;
  padding: 8px 14px;
  border-radius: 6px;
  font-weight: 700;
  font-size: 13px;
  cursor: pointer;
}

.desktop-nav button.active, .desktop-nav button:hover {
  background: var(--bg-input);
  color: var(--text-primary);
}

/* ---------- CONTEÚDO E CARDS ---------- */
.main {
  padding: 20px;
  max-width: 1200px;
  margin: 0 auto;
}

.card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 14px;
  padding: 20px;
  margin-bottom: 16px;
}

.card h2 {
  margin-top: 0;
  font-size: 18px;
  border-bottom: 1px solid var(--border-color);
  padding-bottom: 10px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 12px;
}

.stat {
  background: var(--bg-input);
  border: 1px solid var(--border-color);
  padding: 14px;
  border-radius: 10px;
  text-align: center;
}

.stat b { font-size: 22px; display: block; color: var(--accent-blue); }
.stat span { font-size: 12px; color: var(--text-secondary); }

/* ---------- BOTÕES E INPUTS ---------- */
button, .btn {
  background: var(--accent-blue);
  color: #ffffff;
  border: none;
  padding: 12px 18px;
  border-radius: 8px;
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  transition: opacity 0.2s;
}

button:active { opacity: 0.8; }

button.secondary {
  background: var(--bg-input);
  color: var(--text-primary);
  border: 1px solid var(--border-color);
}

input {
  background: var(--bg-input);
  color: var(--text-primary);
  border: 1px solid var(--border-color);
  padding: 12px;
  border-radius: 8px;
  outline: none;
}

/* ---------- MENU MOBILE INFERIOR ---------- */
.tabbar {
  display: none;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(18, 20, 29, 0.95);
  backdrop-filter: blur(15px);
  border-top: 1px solid var(--border-color);
  padding: 8px 4px;
  z-index: 100;
}

.tabbar-scroll {
  display: flex;
  justify-content: space-around;
}

.tabbar button {
  background: transparent;
  color: var(--text-muted);
  font-size: 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4px;
}

.tabbar button.active { color: var(--accent-blue); }

@media (max-width: 768px) {
  .desktop-nav { display: none; }
  .tabbar { display: block; }
}
